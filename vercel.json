{
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["sin1"],
  "buildCommand": "node scripts/make_sitemap.js && node scripts/copy-public.js",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/js/stations-data.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=300" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=300" }]
    },
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/sitemap(.*).xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "veridrop.cn" }],
      "destination": "https://www.veridrop.cn/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "veridrop.cn" }],
      "destination": "https://www.veridrop.cn/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/rank", "destination": "/" },
    { "source": "/rank/:path*", "destination": "/" }
  ]
}
